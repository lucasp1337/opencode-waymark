{
  "name": "opencode-waymark",
  "version": "0.1.0",
  "description": "Persistent, local-only memory for opencode agents.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "memory",
    "agent",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasp1337/opencode-waymark.git"
  },
  "homepage": "https://github.com/lucasp1337/opencode-waymark#readme",
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "docs/commands.md"
  ],
  "engines": {
    "opencode": "1.19.4"
  },
  "scripts": {
    "test": "bun test --coverage",
    "test:live": "bun test test/live --path-ignore-patterns 'vendor/**' --timeout 240000",
    "test:live:one": "bun test --path-ignore-patterns 'vendor/**' --timeout 240000",
    "lint": "biome check . && knip",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@opencode-ai/plugin": "1.19.4",
    "ulid": "3.0.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/bun": "^1.4.4",
    "knip": "^6.43.0",
    "typescript": "^7.0.2"
  }
}
